# Copy to .env.local for local development. NEVER commit real keys.
# Supabase — dedicated project "darax-jamb-prep" (uvhdpzfylbwrnbtnuruk).
# When these two are set, Supabase Auth + the djp_* tables are the source of
# truth for accounts, profiles, subjects, progress, attempts and notifications.
# Without them the app falls back to the per-device local store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Groq AI (tutor + AI lesson generation). Set on Vercel at deploy time.
# The key is read ONLY from process.env.GROQ_API_KEY — never hardcoded.
GROQ_API_KEY=<redacted>
# First-admin claim code. Change this before going live!
NEXT_PUBLIC_ADMIN_CODE=CHANGE-ME
