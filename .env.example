# Copy to .env.local for local development. NEVER commit real keys.
# Supabase (optional — the app works fully on the local store without these).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Groq AI (tutor + AI lesson generation). Set on Vercel at deploy time.
# The key is read ONLY from process.env.GROQ_API_KEY — never hardcoded.
GROQ_API_KEY=
# First-admin claim code. Change this before going live!
NEXT_PUBLIC_ADMIN_CODE=CHANGE-ME
